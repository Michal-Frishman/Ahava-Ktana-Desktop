QPushButton {
  background-color: #005F73;
  color: white;
  border-radius: 8px;
  padding: 8px 16px;
  font-size: 14px;
}
QPushButton:hover {
  background-color: #0A9396;
}
QPushButton:pressed {
  background-color: #94D2BD;
}
QToolTip {
  background-color: #E9D8A6;
  color: #001219;
  border: none;
  padding: 5px;
  border-radius: 4px;
}
QLineEdit, QComboBox, QDateEdit {
  background-color: #F0F0F0;
  border: 1px solid #CCCCCC;
  border-radius: 4px;
  padding: 4px;
}
QLineEdit:hover, QComboBox:hover {
  border-color: #0A9396;
}
